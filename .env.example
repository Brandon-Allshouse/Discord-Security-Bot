# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
LOG_LEVEL=info

# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Slash commands register only to this guild in development.
DEV_GUILD_ID=

# Dashboard login. The client secret is on the OAuth2 page of the same Discord application.
# On that page, also add this redirect: http://localhost:3000/auth/callback
DISCORD_CLIENT_SECRET=
# Public address of the dashboard. Must be https in production.
DASHBOARD_URL=http://localhost:3000

# Postgres. Inside docker compose the host is "postgres".
POSTGRES_PASSWORD=change-me-to-a-long-random-string
DATABASE_URL=postgres://equinox:change-me-to-a-long-random-string@localhost:5432/equinox

# Redis. Inside docker compose the host is "redis".
REDIS_PASSWORD=change-me-to-a-long-random-string
REDIS_URL=redis://:change-me-to-a-long-random-string@localhost:6379
