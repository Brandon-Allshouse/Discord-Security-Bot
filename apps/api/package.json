{
  "name": "@equinox/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx --env-file=../../.env src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@equinox/config": "workspace:*",
    "@equinox/core": "workspace:*",
    "@equinox/db": "workspace:*",
    "bullmq": "6.3.9",
    "fastify": "5.12.5",
    "ioredis": "6.0.0",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testcontainers/redis": "12.1.0",
    "tsx": "4.23.15"
  }
}
